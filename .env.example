# Server-only. Never prefix these variables with NEXT_PUBLIC_.
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
PAIFLOW_DEPLOYMENT_ID=
# pfd_ developer token with Read and operate + selected deployment, or legacy pfk_.
PAIFLOW_API_TOKEN=
# Shared access code that authorizes campus staff to view payment records.
# Leave unset to keep the staff ledger disabled.
STAFF_ACCESS_CODE=
# Optional path for the local campus payment ledger (JSON). Defaults to .clearpay/store.json.
# CLEARPAY_STORE_PATH=
